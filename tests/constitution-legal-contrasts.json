      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "tax_vs_taxi",
      "left": {
        "form": "takisala",
        "example": {
          "sama": "Takisala bi yoma.",
          "ru": "Налог важен."
        }
      },
      "right": {
        "form": "takisa",
        "example": {
          "sama": "Mi si takisa.",
          "ru": "Я вижу такси."
        }
      },
      "distinction": {
        "ru": "Налог — обязательный публичный платёж, такси — транспортная услуга; формы близки фонетически.",
        "en": "A tax is a levy, a taxi is a transport service; forms need phonetic review."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "emergency_regime_vs_hotline",
      "left": {
        "form": "emewalena",
        "example": {
          "sama": "Emewalena bi yoma.",
          "ru": "Чрезвычайное положение важно."
        }
      },
      "right": {
        "form": "emelena",
        "example": {
          "sama": "Mi tami emelena.",
          "ru": "Я проверяю экстренную линию."
        }
      },
      "distinction": {
        "ru": "Чрезвычайное положение является особым правовым режимом, а экстренная линия — телефонной службой.",
        "en": "A state of emergency is a legal regime, unlike an emergency hotline."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "treasury_vs_central_bank",
      "left": {
        "form": "tesolena",
        "example": {
          "sama": "Tesolena bi yoma.",
          "ru": "Казначейство важно."
        }
      },
      "right": {
        "form": "senatabanaka",
        "example": {
          "sama": "Senatabanaka bi yoma.",
          "ru": "Центральный банк важен."
        }
      },
      "distinction": {
        "ru": "Казначейство исполняет бюджет, центральный банк управляет определёнными денежно-кредитными функциями.",
        "en": "A treasury executes budgets; a central bank has monetary authority."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "entry_into_force_vs_publication",
      "left": {
        "form": "enitulena",
        "example": {
          "sama": "Enitulena bi yoma.",
          "ru": "Вступление в силу важно."
        }
      },
      "right": {
        "form": "pubilita",
        "example": {
          "sama": "Pubilita bi yoma.",
          "ru": "Официальное опубликование важно."
        }
      },
      "distinction": {
        "ru": "Опубликование документа и момент возникновения его юридической силы могут различаться.",
        "en": "Publication and legal effectiveness can occur at distinct times."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "ballot_vs_voter",
      "left": {
        "form": "wotalapa",
        "example": {
          "sama": "Wotalapa bi yoma.",
          "ru": "Бюллетень важен."
        }
      },
      "right": {
        "form": "wotano",
        "example": {
          "sama": "Wotano bi soma.",
          "ru": "Избиратель — человек."
        }
      },
      "distinction": {
        "ru": "Бюллетень фиксирует голос, избиратель обладает правом участия в голосовании.",
        "en": "A ballot records a vote; a voter is an eligible person."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "bank_deposit_vs_fiat_currency",
      "left": {
        "form": "deposita",
        "example": {
          "sama": "Deposita bi yoma.",
          "ru": "Банковский вклад важен."
        }
      },
      "right": {
        "form": "walutapina",
        "example": {
          "sama": "Walutapina bi yoma.",
          "ru": "Фиатная валюта важна."
        }
      },
      "distinction": {
        "ru": "Банковский вклад есть требование к банку, а фиатная валюта — денежная единица.",
        "en": "A bank deposit is a claim on a bank, while fiat currency is money."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "bill_vs_law",
      "left": {
        "form": "lawipota",
        "example": {
          "sama": "Mi lita lawipota.",
          "ru": "Я читаю законопроект."
        }
      },
      "right": {
        "form": "lawi",
        "example": {
          "sama": "Mi lita lawi.",
          "ru": "Я читаю закон."
        }
      },
      "distinction": {
        "ru": "Законопроект не приобретает силу закона до завершения процедуры принятия.",
        "en": "A bill is not an enacted law until adoption."
