{
  "schema": "sama-legal-contrasts/v1",
  "version": "0.1.0",
  "count": 14,
  "notice": "These are author-prepared contrast probes involving candidate lexemes. They are NOT accepted linguistic proofs or constitutional translations.",
  "entries": [
    {
      "id": "constitution_vs_statute",
      "left": {
        "form": "konitusa",
        "example": {
          "sama": "Mi lita konitusa.",
          "ru": "Я читаю Конституцию."
        }
      },
      "right": {
        "form": "lawi",
        "example": {
          "sama": "Mi lita lawi.",
          "ru": "Я читаю закон."
        }
      },
      "distinction": {
        "ru": "Основной закон устанавливает устройство власти; обычный закон принимается по процедуре и должен ему соответствовать.",
        "en": "A constitution structures public authority while a statute is subordinate legislation."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "legal_right_vs_permission",
      "left": {
        "form": "dilewa",
        "example": {
          "sama": "Dilewa bi yoma.",
          "ru": "Юридическое право важно."
        }
      },
      "right": {
        "form": "paku",
        "example": {
          "sama": "Paku bi yoma.",
          "ru": "Разрешение важно."
        }
      },
      "distinction": {
        "ru": "Юридическое притязание может требовать защиты от государства; разрешение лишь допускает действие.",
        "en": "An entitlement can found a legal claim; permission merely authorizes an act."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "ability_vs_right",
      "left": {
        "form": "mosa",
        "example": {
          "sama": "Mi mosa wako.",
          "ru": "Я способен идти."
        }
      },
      "right": {
        "form": "dilewa",
        "example": {
          "sama": "Dilewa bi yoma.",
          "ru": "Юридическое право важно."
        }
      },
      "distinction": {
        "ru": "Возможность физически выполнить действие не означает законное право на него.",
        "en": "Physical ability does not imply an enforceable right."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "republic_vs_democracy",
      "left": {
        "form": "lepubika",
        "example": {
          "sama": "Lepubika bi yoma.",
          "ru": "Республиканская форма важна."
        }
      },
      "right": {
        "form": "demokata",
        "example": {
          "sama": "Demokata bi yoma.",
          "ru": "Демократия важна."
        }
      },
      "distinction": {
        "ru": "Республиканская форма не гарантирует полноценного народовластия.",
        "en": "A republic is not necessarily a democracy."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "state_vs_community",
      "left": {
        "form": "esitata",
        "example": {
          "sama": "Esitata bi yoma.",
          "ru": "Государство важно."
        }
      },
      "right": {
        "form": "koma",
        "example": {
          "sama": "Koma bi yoma.",
          "ru": "Сообщество важно."
        }
      },
      "distinction": {
        "ru": "Государственность предполагает территорию и публично-правовой статус, общество может возникнуть без них.",
        "en": "A state is distinct from a voluntary association."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "citizen_vs_citizenship",
      "left": {
        "form": "sitano",
        "example": {
          "sama": "Sitano bi soma.",
          "ru": "Гражданин является человеком."
        }
      },
      "right": {
        "form": "sitawena",
        "example": {
          "sama": "Sitawena bi yoma.",
          "ru": "Гражданство важно."
