      "distinction": {
        "ru": "Носитель статуса гражданина не равен юридической связи гражданства.",
        "en": "A person holding nationality is not the nationality status itself."
      },
      "status": "editorial_probes_unvalidated"
    },
    {
      "id": "president_vs_leader",
      "left": {
        "form": "pesidena",
        "example": {
          "sama": "Pesidena bi mado.",
          "ru": "Президент является руководителем."
        }
      },
      "right": {
        "form": "mado",
        "example": {
          "sama": "Mado bi yoma.",
          "ru": "Руководитель важен."
        }
      },
      "distinction": {
        "ru": "Руководитель не всегда президент и не имеет автоматически президентских полномочий.",
        "en": "A leader does not automatically hold constitutional presidential powers."
