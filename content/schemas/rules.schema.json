{
  "type": "object",
  "properties": {
    "schema": {
      "const": "sama-rules/v1"
    },
    "version": {
      "const": "0.11.0"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SAMA-RULE/[a-z-]+$"
          },
          "revision": {
            "type": "string",
            "pattern": "^SAMA-RULE/[a-z-]+@0.11.0$"
          },
          "status": {
            "const": "core"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 50
          },
          "summary_en": {
            "type": "string",
            "minLength": 20
          },
          "examples": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "sama": {
                  "type": "string",
                  "minLength": 2
                },
                "ru": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "required": [
                "sama",
                "ru"
              ],
              "additionalProperties": false
            }
          },
          "decision": {
            "const": "ADR-0004"
          }
        },
        "required": [
          "id",
          "revision",
          "status",
          "title",
          "area",
          "text",
          "summary_en",
          "examples",
          "decision"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "version",
    "rules"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
