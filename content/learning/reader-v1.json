{
  "version": "0.13.0",
  "texts": [
    {
      "id": 1,
      "title": "Знакомство",
      "sentences": [
        {
          "sama": "Sala, ami!",
          "ru": "Привет, друг!"
        },
        {
          "sama": "Mi bi na doma.",
          "ru": "Я дома."
        },
        {
          "sama": "Yu bi kalo?",
          "ru": "Где ты?"
        },
        {
          "sama": "Mi la wako to doma.",
          "ru": "Я пойду к дому."
        },
        {
          "sama": "Sayo!",
          "ru": "До свидания!"
        }
      ]
    },
    {
      "id": 2,
      "title": "Книга на столе",
      "sentences": [
        {
          "sama": "Kaso bi na mesa.",
          "ru": "Книга на столе."
        },
        {
          "sama": "Ena kaso bi bona.",
          "ru": "Эта книга хорошая."
        },
        {
          "sama": "Mi kama lita kaso.",
          "ru": "Я хочу читать книгу."
        },
        {
          "sama": "Mama pako kaso to mi.",
          "ru": "Мама даёт мне книгу."
        },
        {
          "sama": "Mi lita kaso.",
          "ru": "Я читаю книгу."
        }
      ]
    },
    {
      "id": 3,
      "title": "За водой",
      "sentences": [
        {
          "sama": "Mi kama pina su.",
          "ru": "Я хочу пить воду."
        },
        {
          "sama": "Su bi na kopa.",
          "ru": "Вода в чашке."
        },
        {
          "sama": "Yu pako kopa to mi, palao.",
          "ru": "Дай мне чашку, пожалуйста."
        },
        {
          "sama": "Mi pina su.",
          "ru": "Я пью воду."
        },
        {
          "sama": "Sani!",
          "ru": "Спасибо!"
        }
      ]
    },
    {
      "id": 4,
      "title": "Вчера и завтра",
      "sentences": [
        {
          "sama": "Mi pa bi na doma.",
          "ru": "Я был дома."
        },
        {
          "sama": "Mi pa hu lita kaso.",
          "ru": "Я был в процессе чтения книги."
        },
        {
          "sama": "Mi pa te lita kaso.",
          "ru": "Я закончил чтение книги."
        },
        {
          "sama": "Mi la wako ko ami.",
          "ru": "Я пойду с другом."
        },
        {
          "sama": "Ani yu la wako, mi la wako.",
          "ru": "Если ты пойдёшь, я пойду."
        }
      ]
    },
    {
      "id": 5,
      "title": "Рабочий день",
      "sentences": [
        {
          "sama": "Mi bi na kapo.",
          "ru": "Я в офисе."
        },
        {
          "sama": "Kome bi na mesa.",
          "ru": "Компьютер на столе."
        },
        {
          "sama": "Mi nawi bama.",
          "ru": "Я начинаю работу."
        },
        {
          "sama": "Mi tami doku.",
          "ru": "Я проверяю документ."
        },
        {
          "sama": "Mi tawi delo.",
          "ru": "Я заканчиваю задачу."
        }
      ]
    },
    {
      "id": 6,
      "title": "Покупка книги",
      "sentences": [
        {
          "sama": "Mi bi na bote.",
          "ru": "Я в магазине."
        },
        {
          "sama": "Mi si kaso nawa.",
          "ru": "Я вижу новую книгу."
        },
        {
          "sama": "Mi nima pese de kaso.",
          "ru": "Я знаю цену книги."
        },
        {
          "sama": "Mi dasi kaso.",
          "ru": "Я покупаю книгу."
        },
        {
          "sama": "Kaso bi nana balo de mi.",
          "ru": "Книга внутри моей сумки."
        }
      ]
    },
    {
      "id": 7,
      "title": "Ключ под столом",
      "sentences": [
        {
          "sama": "Mi no nima kala de misa.",
          "ru": "Я не знаю место ключа."
        },
        {
          "sama": "Mi nopa misa.",
          "ru": "Я ищу ключ."
        },
        {
          "sama": "Misa bi poba mesa.",
          "ru": "Ключ под столом."
        },
        {
          "sama": "Mi wata misa.",
          "ru": "Я нахожу ключ."
        },
        {
          "sama": "Mi tako misa.",
          "ru": "Я беру ключ."
        }
      ]
    },
    {
      "id": 8,
      "title": "Семья дома",
      "sentences": [
        {
          "sama": "Lami de mi bi na doma.",
          "ru": "Моя семья дома."
        },
        {
          "sama": "Mama pina teya.",
          "ru": "Мама пьёт чай."
        },
        {
          "sama": "Boma lita kaso.",
          "ru": "Брат читает книгу."
        },
        {
          "sama": "Sila lena basa.",
          "ru": "Сестра изучает язык."
        },
        {
          "sama": "Mi toka ko mami li.",
          "ru": "Я говорю с родителями."
        }
      ]
    },
    {
      "id": 9,
      "title": "Дождь в городе",
      "sentences": [
        {
          "sama": "Nume bi na bano.",
          "ru": "В городе идёт дождь."
        },
        {
          "sama": "Nubi bi noba bano.",
          "ru": "Над городом облако."
        },
        {
          "sama": "Mi saya tunu.",
          "ru": "Я слышу гром."
        },
        {
          "sama": "Mi si lawana.",
          "ru": "Я вижу молнию."
        },
        {
          "sama": "Temo bi yoma.",
          "ru": "Температура важна."
        }
      ]
    },
    {
      "id": 10,
      "title": "Учёба в университете",
      "sentences": [
        {
          "sama": "Dani li bi na unisa.",
          "ru": "Студенты в университете."
        },
        {
          "sama": "Lenu toka na lekita.",
          "ru": "Преподаватель говорит на лекции."
        },
        {
          "sama": "Ekamo bi tadi.",
          "ru": "Экзамен трудный."
        },
        {
          "sama": "Mi naka tasika.",
          "ru": "Я делаю домашнее задание."
        },
        {
          "sama": "Mi si maleta.",
          "ru": "Я вижу оценку."
        }
      ]
    },
    {
      "id": 11,
      "title": "Работа с кодом",
      "sentences": [
        {
          "sama": "Kiwato bi na mesa.",
          "ru": "Клавиатура находится на столе."
        },
        {
          "sama": "Mi wima kodata.",
          "ru": "Я пишу исходный код."
        },
        {
          "sama": "Mi tami polama.",
          "ru": "Я проверяю программу."
        },
        {
          "sama": "Mi mima paso.",
          "ru": "Я помню пароль."
        },
        {
          "sama": "Datu bi yoma.",
          "ru": "Данные важны."
        }
      ]
    },
    {
      "id": 12,
      "title": "На приёме",
      "sentences": [
        {
          "sama": "Meka bi na kilina.",
          "ru": "Врач находится в поликлинике."
        },
        {
          "sama": "Meka tami simota.",
          "ru": "Врач проверяет симптом."
        },
        {
          "sama": "Meka wima medoka.",
          "ru": "Врач выписывает рецепт."
        },
        {
          "sama": "Mi lita medoka.",
          "ru": "Я читаю рецепт."
        },
        {
          "sama": "Temu bi yoma.",
          "ru": "Запись на приём важна."
        }
      ]
    },
    {
      "id": 13,
      "title": "Документы и суд",
      "sentences": [
        {
          "sama": "Lawiya tami konata.",
          "ru": "Юрист проверяет договор."
        },
        {
          "sama": "Yudi bi na kota.",
          "ru": "Судья находится в суде."
        },
        {
          "sama": "Yudi tami ewida.",
          "ru": "Судья проверяет доказательство."
        },
        {
          "sama": "Mi lita konata.",
          "ru": "Я читаю договор."
        },
        {
          "sama": "Wota de mi bi yoma.",
          "ru": "Мой голос на выборах важен."
        }
      ]
    }
  ]
}
